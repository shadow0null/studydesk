# Fastlane configuration for the StudyDesk iOS WebView shell.
#
# GITHUB-ONLY BUILD: the user has no local Xcode. Everything runs on the
# macOS GitHub Actions runner via .github/workflows/testflight.yml:
#   xcodegen generate → xcodebuild archive → export → TestFlight upload
# All credentials come from GitHub Secrets (see README.md "GitHub Secrets").

default_platform(:ios)

platform :ios do
  desc "Generate the project, archive, and upload to TestFlight"
  lane :beta do
    # 1. Generate StudyDesk.xcodeproj from project.yml (no local Xcode needed).
    #    xcodegen is installed on the runner by the workflow (brew install xcodegen).
    sh("xcodegen generate")

    # TestFlight/App Store builds need the production APNs environment.
    # The repo keeps "development" so local debug builds just work.
    entitlements = "StudyDesk/StudyDesk.entitlements"
    text = File.read(entitlements)
    text = text.gsub(
      "<string>development</string>",
      "<string>production</string>"
    )
    File.write(entitlements, text)
    UI.message("Switched aps-environment to production for the archive")

    # 2. App Store Connect API key (used by match, gym, and pilot).
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
      is_key_content_base64: true,
      in_house: false
    )

    # 3. Code signing via match. Certificates + profiles live in the private
    #    git repo given by MATCH_GIT_URL; MATCH_PASSWORD decrypts them.
    #    The bundle id fun.studydesk.app must exist in the Apple Developer
    #    account with Push Notifications + Associated Domains enabled.
    sync_code_signing(
      type: "appstore",
      api_key: api_key,
      readonly: true
    )

    # Unique build number per CI run (TestFlight requires strictly increasing).
    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"),
      xcodeproj: "StudyDesk.xcodeproj"
    )

    # 4 + 5. Archive (xcodebuild archive) and export (xcodebuild -exportArchive).
    #    Scheme "StudyDesk" comes from project.yml (project name + target name).
    build_app(
      scheme: "StudyDesk",
      export_method: "app-store",
      include_symbols: true,
      include_bitcode: false
    )

    # 6. Upload to TestFlight.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Generate the Xcode project locally (for contributors with Xcode)"
  lane :generate do
    sh("xcodegen generate")
  end
end
